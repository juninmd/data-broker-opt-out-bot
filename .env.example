# ==============================================================================
# DATA BROKER OPT-OUT BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and replace all default/placeholder values with
# secure secrets before launching the Docker Compose stack:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain & Web Proxy (Caddy) Configuration
# ------------------------------------------------------------------------------
# Domain name for the server (used by Caddy to request automatic Let's Encrypt TLS certs).
# For local testing, use 'localhost'. For production, set to your domain (e.g. optout.example.com).
DOMAIN_NAME=localhost

# Email address used for Let's Encrypt ACME registration and expiration alerts.
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Bot Configuration
# ------------------------------------------------------------------------------
# Telegram Bot API Token obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Internal HTTP server port for the bot service
PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Name of the primary database
POSTGRES_DB=databroker

# Database user
POSTGRES_USER=databroker

# Strong secret password for PostgreSQL user
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here

# ------------------------------------------------------------------------------
# Redis Storage & Distributed Locks Configuration
# ------------------------------------------------------------------------------
# Strong secret password for Redis
REDIS_PASSWORD=generate_a_secure_redis_password_here

# ------------------------------------------------------------------------------
# Watchtower Automatic Updates Configuration
# ------------------------------------------------------------------------------
# Time in seconds between image update checks (86400 = 24 hours).
WATCHTOWER_POLL_INTERVAL=86400
